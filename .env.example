# -----------------------------------------------------------------------------
# MARTY configuration.
#
#   cp .env.example .env && chmod 600 .env
#
# Never commit .env: this repository is public.
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
# development | production | test
APP_ENV=development
LOG_LEVEL=INFO
# json (recommended on the server) | console (readable during development)
LOG_FORMAT=console
TIMEZONE=Europe/Madrid

# --- PostgreSQL ----------------------------------------------------------------
# Shared by the db container (initial setup) and the backend.
POSTGRES_DB=marty
POSTGRES_USER=marty
# Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=
# Used when the backend runs outside Docker. docker-compose overrides both
# values for the backend container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host ports published by docker-compose. Both are bound to 127.0.0.1 only.
POSTGRES_HOST_PORT=5432
MARTY_HTTP_PORT=8000

# --- Telegram ------------------------------------------------------------------
TELEGRAM_ENABLED=false
# Token from @BotFather. Use a separate bot for development: Telegram allows
# only one long-polling connection per token.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot (@userinfobot).
TELEGRAM_ALLOWED_USER_IDS=

# --- AI providers --------------------------------------------------------------
# Tried in this order; a provider that is rate-limited or down is skipped.
# Allowed values: gemini, groq, ollama
AI_PROVIDER_ORDER=gemini,groq
# Keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
# Models available to your key: python -m app.integrations.ai.list_models
# Each *_MODEL accepts a comma-separated list, tried in order; free-tier quotas
# are per model (e.g. GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite and
# GROQ_MODEL=openai/gpt-oss-120b).
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
LLM_TIMEOUT_SECONDS=60
# Includes the reasoning tokens of thinking models.
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_TOOL_ITERATIONS=4

# --- Conversation --------------------------------------------------------------
# A new conversation starts after this much silence; the previous one is summarised.
CONVERSATION_IDLE_HOURS=6
# Confirmation buttons stop working after this many hours.
PENDING_ACTION_TTL_HOURS=24

# --- Apple Calendar (Phase 2, not used yet) -------------------------------------
# Use an app-specific password (appleid.apple.com > Sign-In and Security),
# never your Apple Account password.
# CALDAV_URL=https://caldav.icloud.com
# CALDAV_USERNAME=
# CALDAV_PASSWORD=
