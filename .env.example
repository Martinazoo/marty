# -----------------------------------------------------------------------------
# MARTY configuration.
#
#   cp .env.example .env && chmod 600 .env
#
# Never commit .env: this repository is public.
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
# development | production | test
APP_ENV=development
LOG_LEVEL=INFO
# json (recommended on the server) | console (readable during development)
LOG_FORMAT=console
TIMEZONE=Europe/Madrid

# --- PostgreSQL ----------------------------------------------------------------
# Shared by the db container (initial setup) and the backend.
POSTGRES_DB=marty
POSTGRES_USER=marty
# Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=
# Used when the backend runs outside Docker. docker-compose overrides both
# values for the backend container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host ports published by docker-compose. Both are bound to 127.0.0.1 only.
POSTGRES_HOST_PORT=5432
MARTY_HTTP_PORT=8000

# --- Telegram (Phase 1) --------------------------------------------------------
TELEGRAM_ENABLED=false
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot.
TELEGRAM_ALLOWED_USER_IDS=

# --- AI providers (Phase 1) ----------------------------------------------------
# Tried in this order; a provider that is rate-limited or down is skipped.
# Allowed values: gemini, groq, ollama
AI_PROVIDER_ORDER=gemini,groq
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Apple Calendar (Phase 2, not used yet) -------------------------------------
# Use an app-specific password (appleid.apple.com > Sign-In and Security),
# never your Apple Account password.
# CALDAV_URL=https://caldav.icloud.com
# CALDAV_USERNAME=
# CALDAV_PASSWORD=
